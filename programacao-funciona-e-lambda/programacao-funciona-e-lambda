```java

    public interface Consumer<T>{
        void accept(T t);
    }

    // Problema: a partir de uma lista de produtos aumente o preço dos produtos em 10%

    psv main(String[] args) {

        List<Product> list = new ArrayList();

        list.add(new Product("TV", 900.0));
        list.add(new Product("Mouse", 300.0));

        list.forEach(); // recebe um consumer como parametro. É um default method q
                            percorre a coleção e executar um consumer nessa coleção
                            para cada elemento
    }

    public class PriceUpdate implements Consumer<Product>{

        public void accept(Product p){
            p.setPrice(p.getPrice() * 1.1);
        }
    }

    psv main(String[] args) {
        list.forEach(new PriceUpdate()); // isso vai atualizar o preco de todos produtos da lista
        list.foreach(System.out::println); // vai imprimir todosos produtos
    }

    // Reference method com método estático

    class Product {
        public static void staticPriceUpdate(Product p){
            p.setPrice(p.getPrice() * 1.1);
        }
    }

    psv main(String[] args) {
        list.foreach(Product::staticPriceUpdate);
    }

    // Reference method com método não estático

    class Product {
        public static void nonStaticPriceUpdate(){
            price = price * 1.1;
        }
    }

    psv main(String[] args) {
        list.foreach(Product::nonStaticPriceUpdate);
    }

    // Expressão lambda declarada

        psv main(String[] args) {

            Consumer<Product> cons = p -> p.setPrice(p.getPrice() * 1.1);

